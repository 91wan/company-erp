}

model CertificateRecord {
  id                    String                    @id @default(uuid()) @db.Uuid
  certificateCode       String                    @unique @map("certificate_code")
  certificateName       String                    @map("certificate_name")
  certificateType       CertificateType           @map("certificate_type")
  ownerType             CertificateOwnerType      @map("owner_type")
  ownerEmployeeId       String?                   @map("owner_employee_id") @db.Uuid
  ownerRosterPersonId   String?                   @map("owner_roster_person_id") @db.Uuid
  ownerProjectSiteId    String?                   @map("owner_project_site_id") @db.Uuid
  ownerPartyId          String?                   @map("owner_party_id") @db.Uuid
  ownerNameSnapshot     String                    @map("owner_name_snapshot")
  certificateNumber     String?                   @map("certificate_number")
  issuingAuthority      String?                   @map("issuing_authority")
  certificateScope      String?                   @map("certificate_scope")
  issueDate             DateTime?                 @map("issue_date") @db.Date
  validityType          CertificateValidityType   @map("validity_type")
  expiryDate            DateTime?                 @map("expiry_date") @db.Date
  nextReviewDate        DateTime?                 @map("next_review_date") @db.Date
  reminderDays          Int                       @default(30) @map("reminder_days")
  isComplianceCritical  Boolean                   @default(false) @map("is_compliance_critical")
  attachmentPath        String?                   @map("attachment_path")
  sourceFilePath        String?                   @map("source_file_path")
  sourcePageNo          Int?                      @map("source_page_no")
  responsibleEmployeeId String?                   @map("responsible_employee_id") @db.Uuid
  confirmedByEmployeeId String?                   @map("confirmed_by_employee_id") @db.Uuid
  confirmedAt           DateTime?                 @map("confirmed_at")
  isDisabled            Boolean                   @default(false) @map("is_disabled")
  remark                String?
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  ownerEmployee       Employee?    @relation("CertificateOwnerEmployee", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  ownerRosterPerson   ProjectSiteRosterPerson? @relation(fields: [ownerRosterPersonId], references: [id], onDelete: SetNull)
  ownerProjectSite    ProjectSite? @relation(fields: [ownerProjectSiteId], references: [id], onDelete: SetNull)
  ownerParty          Party?       @relation(fields: [ownerPartyId], references: [id], onDelete: SetNull)
  responsibleEmployee Employee?    @relation("CertificateResponsibleEmployee", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  confirmedByEmployee Employee?    @relation("CertificateConfirmedByEmployee", fields: [confirmedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([certificateType])
  @@index([ownerType])
  @@index([ownerEmployeeId])
  @@index([ownerRosterPersonId])
  @@index([ownerProjectSiteId])
  @@index([ownerPartyId])
  @@index([responsibleEmployeeId])
  @@index([expiryDate])
  @@index([nextReviewDate])
  @@map("certificate_records")
}

model ImportJob {
  id               String             @id @default(uuid()) @db.Uuid
  templateType     ImportTemplateType @map("template_type")
  originalFileName String             @map("original_file_name")
  fileHash         String             @map("file_hash")
  status           ImportJobStatus    @default(previewed)
  totalRows        Int                @default(0) @map("total_rows")
  validRows        Int                @default(0) @map("valid_rows")
  warningRows      Int                @default(0) @map("warning_rows")
  errorRows        Int                @default(0) @map("error_rows")
  skippedRows      Int                @default(0) @map("skipped_rows")
  importedRows     Int                @default(0) @map("imported_rows")
  confirmedAt      DateTime?          @map("confirmed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  rows             ImportJobRow[]

  @@index([templateType, status])
  @@index([createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id               String          @id @default(uuid()) @db.Uuid
  importJobId      String          @map("import_job_id") @db.Uuid
  rowNumber        Int             @map("row_number")
  rawData          Json            @map("raw_data")
  normalizedData   Json?           @map("normalized_data")
  issues           Json
  status           ImportRowStatus
  targetRecordType String?         @map("target_record_type")
  targetRecordId   String?         @map("target_record_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([status])
  @@index([targetRecordType, targetRecordId])
  @@map("import_job_rows")
}
