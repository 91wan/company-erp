model PurchaseRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  requestNo           String                @unique @map("request_no")
  requesterName       String                @map("requester_name")
  requesterEmployeeId String?               @map("requester_employee_id") @db.Uuid
  departmentName      String                @map("department_name")
  departmentId        String?               @map("department_id") @db.Uuid
  projectSiteId       String?               @map("project_site_id") @db.Uuid
  expectedArrivalDate DateTime?             @map("expected_arrival_date") @db.Date
  purpose             String?
  status              PurchaseRequestStatus @default(draft)
  submittedAt         DateTime?             @map("submitted_at")
  reviewedAt          DateTime?             @map("reviewed_at")
  reviewedByEmployeeId String?              @map("reviewed_by_employee_id") @db.Uuid
  reviewedByName      String?               @map("reviewed_by_name")
  reviewRemark        String?               @map("review_remark")
  remark              String?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  requester   Employee?              @relation("PurchaseRequestRequester", fields: [requesterEmployeeId], references: [id], onDelete: SetNull)
  reviewedBy  Employee?              @relation("PurchaseRequestReviewer", fields: [reviewedByEmployeeId], references: [id], onDelete: SetNull)
  department  Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectSite ProjectSite?           @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  lines       PurchaseRequestLine[]
  records     PurchaseRecord[]
