model Contract {
  id                       String             @id @default(uuid()) @db.Uuid
  contractNo               String             @unique @map("contract_no")
  contractName             String             @map("contract_name")
  counterpartyPartyId      String             @map("counterparty_party_id") @db.Uuid
  counterpartyNameSnapshot String             @map("counterparty_name_snapshot")
  direction                ContractDirection
  contractForm             ContractForm       @default(fixed_term) @map("contract_form")
  subjectCategory          ContractSubjectCategory @default(other) @map("subject_category")
  investmentCategory       ContractInvestmentCategory? @map("investment_category")
  businessProjectId        String?            @map("business_project_id") @db.Uuid
  projectSiteId            String?            @map("project_site_id") @db.Uuid
  signedDate               DateTime?          @map("signed_date") @db.Date
  startDate                DateTime           @map("start_date") @db.Date
  endDate                  DateTime?          @map("end_date") @db.Date
  amount                   Decimal?           @db.Decimal(14, 2)
  budgetAmount             Decimal?           @map("budget_amount") @db.Decimal(14, 2)
  currency                 String             @default("CNY")
  attachmentRef            String?            @map("attachment_ref")
  status                   ContractStatus     @default(active)
  remark                   String?
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  counterpartyParty Party                @relation(fields: [counterpartyPartyId], references: [id], onDelete: Restrict)
  businessProject   BusinessProject?     @relation(fields: [businessProjectId], references: [id], onDelete: SetNull)
  projectSite       ProjectSite?         @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  attachments       ContractAttachment[]
  purchaseRecords   PurchaseRecord[]
  kitchenEquipment  ProjectSiteKitchenEquipment[]

  @@index([counterpartyPartyId])
  @@index([businessProjectId])
  @@index([projectSiteId])
  @@index([direction])
  @@index([contractForm])
  @@index([subjectCategory])
  @@index([investmentCategory])
  @@index([status])
  @@index([endDate])
  @@map("contracts")
}

