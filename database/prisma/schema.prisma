  @@index([status])
  @@index([requesterEmployeeId])
  @@index([reviewedByEmployeeId])
  @@index([departmentId])
  @@index([projectSiteId])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                 String   @id @default(uuid()) @db.Uuid
