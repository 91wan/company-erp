generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WarehouseType {
  headquarters
  project_site
  temporary
}

enum InventoryMovementType {
  opening
  inbound
  outbound
  adjustment_in
  adjustment_out
}

enum InventorySourceType {
  purchase
  return_material
  inventory_gain
  opening
  project_usage
  other
}

enum IssueTargetType {
  internal_office
  project_site
  subcontractor
}

enum ChargePriceSource {
  project_site_price
}

enum ProjectUsageStatus {
  pending
  issued
  partially_issued
  rejected
}

enum ReplenishmentSuggestionStatus {
  open
  converted
  dismissed
}

enum PartyType {
  supplier
  client
  subcontractor
  operator
}

enum ProjectSiteServiceMode {
  direct
  subcontracted
}

enum PurchaseRequestStatus {
  draft
  pending_purchase
  purchasing
  partially_received
  completed
  cancelled
}

enum PurchaseRecordStatus {
  pending_purchase
  ordered
  partially_received
  received
  cancelled
}

enum PurchaseSourceType {
  platform
  supplier
  offline
}

enum ContractDirection {
  purchase_contract
  client_service_contract
  subcontract_contract
  framework_contract
  other
}

enum ContractStatus {
  active
  terminated
}

enum ImportTemplateType {
  parties
  materials
  employees
  project_sites
  opening_inventory
}

enum ImportJobStatus {
  previewed
  confirmed
  failed
}

enum ImportRowStatus {
  valid
  warning
  error
  skipped
  imported
}

model Party {
  id                      String        @id @default(uuid()) @db.Uuid
  partyCode               String        @unique @map("party_code")
  partyName               String        @map("party_name")
  partyTypes              PartyType[]   @map("party_types")
  unifiedSocialCreditCode String?       @unique @map("unified_social_credit_code")
  primaryContactName      String?       @map("primary_contact_name")
  primaryContactPhone     String?       @map("primary_contact_phone")
  supplyCategory          String?       @map("supply_category")
  commonMaterials         String?       @map("common_materials")
  address                 String?
  settlementNotes         String?       @map("settlement_notes")
  status                  BaseStatus    @default(enabled)
  remark                  String?
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  defaultedMaterials        Material[]    @relation("DefaultSupplierMaterials")
  clientProjectSites        ProjectSite[] @relation("ProjectSiteClientParty")
  operatorProjectSites      ProjectSite[] @relation("ProjectSiteOperatorParty")
  subcontractorProjectSites ProjectSite[] @relation("ProjectSiteSubcontractorParty")
  purchaseRecords           PurchaseRecord[]
  contracts                 Contract[]

  @@index([status])
  @@index([partyName])
  @@map("parties")
}

model Material {
  id                 String                  @id @default(uuid()) @db.Uuid
  materialCode       String                  @unique @map("material_code")
  materialName       String                  @map("material_name")
  specification      String?
  materialCategory   String                  @map("material_category")
  baseUnit           String                  @map("base_unit")
  defaultWarehouseId String?                 @map("default_warehouse_id") @db.Uuid
  defaultSupplierPartyId String?             @map("default_supplier_party_id") @db.Uuid
  safeStock          Decimal?                @map("safe_stock") @db.Decimal(14, 3)
  isProjectSiteSaleEnabled Boolean           @default(false) @map("is_project_site_sale_enabled")
  purchaseReferencePrice Decimal?            @map("purchase_reference_price") @db.Decimal(14, 4)
  projectSiteSalePrice Decimal?              @map("project_site_sale_price") @db.Decimal(14, 4)
  projectSiteSaleUnit String?                @map("project_site_sale_unit")
  projectSiteSaleRemark String?              @map("project_site_sale_remark")
  isConsumable       Boolean                 @default(false) @map("is_consumable")
  status             BaseStatus              @default(enabled)
  remark             String?
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  defaultWarehouse   Warehouse?              @relation("DefaultWarehouseMaterials", fields: [defaultWarehouseId], references: [id])
  defaultSupplierParty Party?                 @relation("DefaultSupplierMaterials", fields: [defaultSupplierPartyId], references: [id], onDelete: SetNull)
  movements          InventoryMovement[]
  usageRequests      ProjectUsageRequest[]
  replenishmentSuggestions ReplenishmentSuggestion[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseRecordLines  PurchaseRecordLine[]

  @@index([defaultSupplierPartyId])
  @@map("materials")
}

model Warehouse {
  id                 String              @id @default(uuid()) @db.Uuid
  warehouseCode      String              @unique @map("warehouse_code")
  warehouseName      String              @map("warehouse_name")
  warehouseType      WarehouseType       @default(headquarters) @map("warehouse_type")
  projectSiteId      String?             @map("project_site_id") @db.Uuid
  managerName        String?             @map("manager_name")
  managerPhone       String?             @map("manager_phone")
  status             BaseStatus          @default(enabled)
  remark             String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  projectSite        ProjectSite?        @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  defaultedMaterials Material[]          @relation("DefaultWarehouseMaterials")
  movements          InventoryMovement[]
  usageRequests      ProjectUsageRequest[]
  replenishmentSuggestions ReplenishmentSuggestion[]

  @@index([projectSiteId])
  @@map("warehouses")
}

model InventoryMovement {
  id                    String                 @id @default(uuid()) @db.Uuid
  movementNo            String                 @unique @map("movement_no")
  movementDate          DateTime               @map("movement_date") @db.Date
  movementType          InventoryMovementType  @map("movement_type")
  sourceType            InventorySourceType?   @map("source_type")
  issueTargetType       IssueTargetType?       @map("issue_target_type")
  warehouseId           String                 @map("warehouse_id") @db.Uuid
  materialId            String                 @map("material_id") @db.Uuid
  quantity              Decimal                @db.Decimal(14, 3)
  unit                  String
  unitPrice             Decimal?               @map("unit_price") @db.Decimal(14, 4)
  unitChargePrice       Decimal?               @map("unit_charge_price") @db.Decimal(14, 4)
  chargeAmount          Decimal?               @map("charge_amount") @db.Decimal(14, 4)
  chargePriceSource     ChargePriceSource?     @map("charge_price_source")
  chargeRemark          String?                @map("charge_remark")
  purchaseRecordNo      String?                @map("purchase_record_no")
  purchaseRecordLineId  String?                @map("purchase_record_line_id") @db.Uuid
  projectSiteId         String?                @map("project_site_id") @db.Uuid
  subcontractorName     String?                @map("subcontractor_name")
  departmentName        String?                @map("department_name")
  requestedBy           String?                @map("requested_by")
  handledBy             String?                @map("handled_by")
  receivedByName        String?                @map("received_by_name")
  purpose               String?
  remark                String?
  usageRequestId        String?                @map("usage_request_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  material              Material               @relation(fields: [materialId], references: [id])
  purchaseRecordLine    PurchaseRecordLine?    @relation(fields: [purchaseRecordLineId], references: [id], onDelete: SetNull)
  projectSite           ProjectSite?           @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  usageRequest          ProjectUsageRequest?   @relation(fields: [usageRequestId], references: [id])

  @@index([warehouseId, materialId, movementDate])
  @@index([movementType, movementDate])
  @@index([purchaseRecordLineId])
  @@index([projectSiteId])
  @@map("inventory_movements")
}

model ProjectUsageRequest {
  id                String               @id @default(uuid()) @db.Uuid
  requestNo         String               @unique @map("request_no")
  requestDate       DateTime             @map("request_date") @db.Date
  projectSiteId     String               @map("project_site_id") @db.Uuid
  warehouseId       String               @map("warehouse_id") @db.Uuid
  materialId        String               @map("material_id") @db.Uuid
  requestedQuantity Decimal              @map("requested_quantity") @db.Decimal(14, 3)
  approvedQuantity  Decimal?             @map("approved_quantity") @db.Decimal(14, 3)
  issuedQuantity    Decimal              @default(0) @map("issued_quantity") @db.Decimal(14, 3)
  unit              String
  purpose           String?
  requestedBy       String?              @map("requested_by")
  expectedDate      DateTime?            @map("expected_date") @db.Date
  status            ProjectUsageStatus   @default(pending)
  outboundNo        String?              @map("outbound_no")
  unitChargePrice   Decimal?             @map("unit_charge_price") @db.Decimal(14, 4)
  chargeAmount      Decimal              @default(0) @map("charge_amount") @db.Decimal(14, 4)
  chargePriceSource ChargePriceSource?   @map("charge_price_source")
  chargeRemark      String?              @map("charge_remark")
  lastIssuedAt      DateTime?            @map("last_issued_at") @db.Date
  lastReceivedByName String?             @map("last_received_by_name")
  remark            String?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  projectSite       ProjectSite          @relation(fields: [projectSiteId], references: [id], onDelete: Restrict)
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id])
  material          Material             @relation(fields: [materialId], references: [id])
  movements         InventoryMovement[]

  @@index([projectSiteId, requestDate])
  @@index([status])
  @@map("project_usage_requests")
}

model ReplenishmentSuggestion {
  id                         String                         @id @default(uuid()) @db.Uuid
  warehouseId                String                         @map("warehouse_id") @db.Uuid
  materialId                 String                         @map("material_id") @db.Uuid
  safeStock                  Decimal                        @map("safe_stock") @db.Decimal(14, 3)
  currentStock               Decimal                        @map("current_stock") @db.Decimal(14, 3)
  reservedUsageQty           Decimal                        @map("reserved_usage_qty") @db.Decimal(14, 3)
  openPurchaseQty            Decimal                        @map("open_purchase_qty") @db.Decimal(14, 3)
  suggestedQuantity          Decimal                        @map("suggested_quantity") @db.Decimal(14, 3)
  status                     ReplenishmentSuggestionStatus  @default(open)
  convertedPurchaseRequestId String?                        @map("converted_purchase_request_id") @db.Uuid
  remark                     String?
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")

  warehouse                Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  material                 Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  convertedPurchaseRequest PurchaseRequest? @relation("ReplenishmentConvertedRequest", fields: [convertedPurchaseRequestId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([materialId])
  @@index([status])
  @@index([convertedPurchaseRequestId])
  @@map("replenishment_suggestions")
}

enum BaseStatus {
  enabled
  disabled
}

enum EmployeeStatus {
  active
  resigned
  disabled
}

enum UserAccountStatus {
  active
  disabled
  locked
}

enum RoleCode {
  admin
  hr
  procurement
  warehouse
  project_site
  viewer
}

enum ProjectSiteStatus {
  preparing
  active
  paused
  ended
}

enum EmployeeProjectSiteRelationType {
  assigned
  manager
  support
}

model Department {
  id                String       @id @default(uuid()) @db.Uuid
  departmentCode    String       @unique @map("department_code")
  name              String
  parentId          String?      @map("parent_id") @db.Uuid
  managerEmployeeId String?      @map("manager_employee_id") @db.Uuid
  status            BaseStatus   @default(enabled)
  sortOrder         Int          @default(0) @map("sort_order")
  remark            String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  parent          Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Department[] @relation("DepartmentHierarchy")
  managerEmployee Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees       Employee[]   @relation("EmployeeDepartment")
  purchaseRequests PurchaseRequest[]

  @@index([parentId])
  @@index([status])
  @@map("departments")
}

model Employee {
  id               String         @id @default(uuid()) @db.Uuid
  employeeNo       String         @unique @map("employee_no")
  name             String
  gender           String?
  phone            String?        @unique
  email            String?        @unique
  departmentId     String         @map("department_id") @db.Uuid
  position         String?
  employmentStatus EmployeeStatus @default(active) @map("employment_status")
  hireDate         DateTime?      @map("hire_date") @db.Date
  leaveDate        DateTime?      @map("leave_date") @db.Date
  remark           String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  department             Department                      @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  userAccount            UserAccount?
  managedDepartments     Department[]                    @relation("DepartmentManager")
  managedProjectSites    ProjectSite[]                   @relation("ProjectSitePrimaryManager")
  projectSiteAssignments EmployeeProjectSiteAssignment[]
  requestedPurchases     PurchaseRequest[]               @relation("PurchaseRequestRequester")
  handledPurchases       PurchaseRecord[]                @relation("PurchaseRecordPurchaser")

  @@index([departmentId])
  @@index([employmentStatus])
  @@map("employees")
}

model UserAccount {
  id                String            @id @default(uuid()) @db.Uuid
  employeeId        String?           @unique @map("employee_id") @db.Uuid
  username          String            @unique
  passwordHash      String            @map("password_hash")
  status            UserAccountStatus @default(active)
  lastLoginAt       DateTime?         @map("last_login_at")
  passwordChangedAt DateTime?         @map("password_changed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  employee            Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles               UserRoleAssignment[]  @relation("UserAccountRoles")
  assignedRoleChanges UserRoleAssignment[]  @relation("AssignedUserRoles")

  @@index([status])
  @@map("user_accounts")
}

model UserRoleAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  userAccountId    String    @map("user_account_id") @db.Uuid
  role             RoleCode
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at")

  userAccount UserAccount  @relation("UserAccountRoles", fields: [userAccountId], references: [id], onDelete: Cascade)
  assignedBy  UserAccount? @relation("AssignedUserRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userAccountId, role])
  @@index([role])
  @@index([assignedByUserId])
  @@map("user_role_assignments")
}

model ProjectSite {
  id                       String            @id @default(uuid()) @db.Uuid
  siteCode                 String            @unique @map("site_code")
  siteName                 String            @map("site_name")
  clientPartyId            String?           @map("client_party_id") @db.Uuid
  operatorPartyId          String?           @map("operator_party_id") @db.Uuid
  serviceMode              ProjectSiteServiceMode @default(direct) @map("service_mode")
  subcontractorPartyId     String?           @map("subcontractor_party_id") @db.Uuid
  region                   String?
  siteAddress              String?           @map("site_address")
  serviceType              String?           @map("service_type")
  status                   ProjectSiteStatus @default(active)
  startDate                DateTime?         @map("start_date") @db.Date
  endDate                  DateTime?         @map("end_date") @db.Date
  primaryManagerEmployeeId String?           @map("primary_manager_employee_id") @db.Uuid
  clientContactName        String?           @map("client_contact_name")
  clientContactPhone       String?           @map("client_contact_phone")
  subcontractorContactName String?           @map("subcontractor_contact_name")
  subcontractorContactPhone String?          @map("subcontractor_contact_phone")
  remark                   String?
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  primaryManager Employee?                       @relation("ProjectSitePrimaryManager", fields: [primaryManagerEmployeeId], references: [id], onDelete: SetNull)
  clientParty    Party?                          @relation("ProjectSiteClientParty", fields: [clientPartyId], references: [id], onDelete: Restrict)
  operatorParty  Party?                          @relation("ProjectSiteOperatorParty", fields: [operatorPartyId], references: [id], onDelete: Restrict)
  subcontractorParty Party?                       @relation("ProjectSiteSubcontractorParty", fields: [subcontractorPartyId], references: [id], onDelete: Restrict)
  assignments    EmployeeProjectSiteAssignment[]
  warehouses      Warehouse[]
  inventoryMoves  InventoryMovement[]
  usageRequests   ProjectUsageRequest[]
  purchaseRequests PurchaseRequest[]
  contracts        Contract[]

  @@index([status])
  @@index([primaryManagerEmployeeId])
  @@index([clientPartyId])
  @@index([operatorPartyId])
  @@index([subcontractorPartyId])
  @@map("project_sites")
}

model EmployeeProjectSiteAssignment {
  id             String                          @id @default(uuid()) @db.Uuid
  employeeId     String                          @map("employee_id") @db.Uuid
  projectSiteId  String                          @map("project_site_id") @db.Uuid
  relationType   EmployeeProjectSiteRelationType @default(assigned) @map("relation_type")
  isPrimary      Boolean                         @default(false) @map("is_primary")
  startDate      DateTime?                       @map("start_date") @db.Date
  endDate        DateTime?                       @map("end_date") @db.Date
  createdAt      DateTime                        @default(now()) @map("created_at")
  updatedAt      DateTime                        @updatedAt @map("updated_at")

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectSite ProjectSite @relation(fields: [projectSiteId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([projectSiteId])
  @@index([relationType])
  @@map("employee_project_site_assignments")
}

model PurchaseRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  requestNo           String                @unique @map("request_no")
  requesterName       String                @map("requester_name")
  requesterEmployeeId String?               @map("requester_employee_id") @db.Uuid
  departmentName      String                @map("department_name")
  departmentId        String?               @map("department_id") @db.Uuid
  projectSiteId       String?               @map("project_site_id") @db.Uuid
  expectedArrivalDate DateTime?             @map("expected_arrival_date") @db.Date
  purpose             String?
  status              PurchaseRequestStatus @default(draft)
  remark              String?
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  requester   Employee?              @relation("PurchaseRequestRequester", fields: [requesterEmployeeId], references: [id], onDelete: SetNull)
  department  Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectSite ProjectSite?           @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  lines       PurchaseRequestLine[]
  records     PurchaseRecord[]
  replenishmentSuggestions ReplenishmentSuggestion[] @relation("ReplenishmentConvertedRequest")

  @@index([status])
  @@index([requesterEmployeeId])
  @@index([departmentId])
  @@index([projectSiteId])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                 String   @id @default(uuid()) @db.Uuid
  purchaseRequestId  String   @map("purchase_request_id") @db.Uuid
  materialId         String?  @map("material_id") @db.Uuid
  materialCode       String?  @map("material_code")
  materialName       String   @map("material_name")
  specification      String?
  requestedQuantity  Decimal  @map("requested_quantity") @db.Decimal(14, 3)
  unit               String
  remark             String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest      @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  material        Material?            @relation(fields: [materialId], references: [id], onDelete: SetNull)
  purchaseLines   PurchaseRecordLine[]

  @@index([purchaseRequestId])
  @@index([materialId])
  @@map("purchase_request_lines")
}

model PurchaseRecord {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseNo          String               @unique @map("purchase_no")
  purchaseRequestId   String?              @map("purchase_request_id") @db.Uuid
  purchaseRequestNo   String?              @map("purchase_request_no")
  purchaserName       String               @map("purchaser_name")
  purchaserEmployeeId String?              @map("purchaser_employee_id") @db.Uuid
  sourceType          PurchaseSourceType   @map("source_type")
  purchasePlatform    String?              @map("purchase_platform")
  platformOrderNo     String?              @map("platform_order_no")
  shopName            String?              @map("shop_name")
  supplierPartyId     String?              @map("supplier_party_id") @db.Uuid
  contractId          String?              @map("contract_id") @db.Uuid
  supplierNameText    String?              @map("supplier_name_text")
  purchaseDescription String?              @map("purchase_description")
  purchaseDate        DateTime             @map("purchase_date") @db.Date
  expectedArrivalDate DateTime?            @map("expected_arrival_date") @db.Date
  receivedQuantity    Decimal              @default(0) @map("received_quantity") @db.Decimal(14, 3)
  status              PurchaseRecordStatus @default(pending_purchase)
  remark              String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest?     @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  purchaser       Employee?            @relation("PurchaseRecordPurchaser", fields: [purchaserEmployeeId], references: [id], onDelete: SetNull)
  supplierParty   Party?               @relation(fields: [supplierPartyId], references: [id], onDelete: SetNull)
  contract        Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lines           PurchaseRecordLine[]

  @@index([status])
  @@index([sourceType])
  @@index([purchaseRequestId])
  @@index([purchaserEmployeeId])
  @@index([supplierPartyId])
  @@index([contractId])
  @@map("purchase_records")
}

model PurchaseRecordLine {
  id                    String   @id @default(uuid()) @db.Uuid
  purchaseRecordId      String   @map("purchase_record_id") @db.Uuid
  purchaseRequestLineId String?  @map("purchase_request_line_id") @db.Uuid
  materialId            String?  @map("material_id") @db.Uuid
  materialCode          String?  @map("material_code")
  materialName          String   @map("material_name")
  specification         String?
  purchaseQuantity      Decimal  @map("purchase_quantity") @db.Decimal(14, 3)
  unit                  String
  purchasePrice         Decimal? @map("purchase_price") @db.Decimal(14, 4)
  receivedQuantity      Decimal  @default(0) @map("received_quantity") @db.Decimal(14, 3)
  remark                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  purchaseRecord      PurchaseRecord       @relation(fields: [purchaseRecordId], references: [id], onDelete: Cascade)
  purchaseRequestLine PurchaseRequestLine?  @relation(fields: [purchaseRequestLineId], references: [id], onDelete: SetNull)
  material            Material?             @relation(fields: [materialId], references: [id], onDelete: SetNull)
  inventoryMovements  InventoryMovement[]

  @@index([purchaseRecordId])
  @@index([purchaseRequestLineId])
  @@index([materialId])
  @@map("purchase_record_lines")
}

model Contract {
  id                       String             @id @default(uuid()) @db.Uuid
  contractNo               String             @unique @map("contract_no")
  contractName             String             @map("contract_name")
  counterpartyPartyId      String             @map("counterparty_party_id") @db.Uuid
  counterpartyNameSnapshot String             @map("counterparty_name_snapshot")
  direction                ContractDirection
  projectSiteId            String?            @map("project_site_id") @db.Uuid
  signedDate               DateTime?          @map("signed_date") @db.Date
  startDate                DateTime           @map("start_date") @db.Date
  endDate                  DateTime           @map("end_date") @db.Date
  amount                   Decimal?           @db.Decimal(14, 2)
  budgetAmount             Decimal?           @map("budget_amount") @db.Decimal(14, 2)
  currency                 String             @default("CNY")
  attachmentRef            String?            @map("attachment_ref")
  status                   ContractStatus     @default(active)
  remark                   String?
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  counterpartyParty Party                @relation(fields: [counterpartyPartyId], references: [id], onDelete: Restrict)
  projectSite       ProjectSite?         @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  attachments       ContractAttachment[]
  purchaseRecords   PurchaseRecord[]

  @@index([counterpartyPartyId])
  @@index([projectSiteId])
  @@index([direction])
  @@index([status])
  @@index([endDate])
  @@map("contracts")
}

model ContractAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileType   String?  @map("file_type")
  fileSize   Int?     @map("file_size")
  uploadedBy String?  @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  remark     String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_attachments")
}

model ImportJob {
  id               String             @id @default(uuid()) @db.Uuid
  templateType     ImportTemplateType @map("template_type")
  originalFileName String             @map("original_file_name")
  fileHash         String             @map("file_hash")
  status           ImportJobStatus    @default(previewed)
  totalRows        Int                @default(0) @map("total_rows")
  validRows        Int                @default(0) @map("valid_rows")
  warningRows      Int                @default(0) @map("warning_rows")
  errorRows        Int                @default(0) @map("error_rows")
  skippedRows      Int                @default(0) @map("skipped_rows")
  importedRows     Int                @default(0) @map("imported_rows")
  confirmedAt      DateTime?          @map("confirmed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  rows             ImportJobRow[]

  @@index([templateType, status])
  @@index([createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id               String          @id @default(uuid()) @db.Uuid
  importJobId      String          @map("import_job_id") @db.Uuid
  rowNumber        Int             @map("row_number")
  rawData          Json            @map("raw_data")
  normalizedData   Json?           @map("normalized_data")
  issues           Json
  status           ImportRowStatus
  targetRecordType String?         @map("target_record_type")
  targetRecordId   String?         @map("target_record_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  importJob        ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([status])
  @@index([targetRecordType, targetRecordId])
  @@map("import_job_rows")
}
