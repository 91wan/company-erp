generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WarehouseType {
  headquarters
  project_site
  temporary
}

enum InventoryMovementType {
  opening
  inbound
  outbound
  adjustment_in
  adjustment_out
}

enum InventorySourceType {
  purchase
  return_material
  inventory_gain
  opening
  project_usage
  other
}

enum IssueTargetType {
  project_site
  subcontractor
  company_department
  company_person
}

enum ChargePriceSource {
  project_site_price
}

enum ProjectUsageStatus {
  pending
  issued
  partially_issued
  rejected
}

enum ReplenishmentSuggestionStatus {
  open
  converted
  dismissed
}

enum PartyType {
  supplier
  client
  subcontractor
  operator
}

enum PartyEntityType {
  company
  individual
}

model AppConfig {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

enum ProjectSiteServiceMode {
  direct
  subcontracted
}

enum PurchaseRequestStatus {
  draft
  pending_approval
  pending_purchase
  purchasing
  partially_received
  completed
  rejected
  cancelled
}

enum PurchaseRecordStatus {
  pending_purchase
  ordered
  partially_received
  received
  cancelled
}

enum PurchaseSourceType {
  platform
  supplier
  offline
}

enum ContractDirection {
  purchase_contract
  client_service_contract
  subcontract_contract
  other
}

enum ContractForm {
  one_time
  fixed_term
  framework
  project_construction
}

enum ContractSubjectCategory {
  food_ingredients
  tableware_supplies
  kitchen_equipment
  advertising_signage
  renovation
  civil_construction
  elevator
  service_operation
  labor_subcontract
  other
}

enum ContractInvestmentCategory {
  renovation
  equipment
  advertising_signage
  tableware_supplies
  other
}

enum ContractStatus {
  draft
  active
  completed
  terminated
  cancelled
}

enum BusinessProjectType {
  self_operated_construction
}

enum BusinessProjectStatus {
  preparing
  in_progress
  active
  paused
  ended
  cancelled
}

enum CertificateType {
  person_health_cert
  employer_liability_insurance
  business_license
  food_operation_license
  project_site_license
  supplier_qualification
  management_system_cert
  food_safety_cert
  credit_rating_cert
  honor_cert
  bank_account_permit
  contract_qualification_file
  other
}

enum CertificateOwnerType {
  person
  project_site
  supplier
  company
}

enum CertificateValidityType {
  fixed_expiry
  long_term
  no_expiry_visible
}

enum ImportTemplateType {
  parties
  materials
  employees
  project_sites
  opening_inventory
}

enum ImportJobStatus {
  previewed
  confirmed
  failed
}

enum ImportRowStatus {
  valid
  warning
  error
  skipped
  imported
}

model Party {
  id                      String        @id @default(uuid()) @db.Uuid
  partyCode               String        @unique @map("party_code")
  partyName               String        @map("party_name")
  partyTypes              PartyType[]   @map("party_types")
  entityType              PartyEntityType @default(company) @map("entity_type")
  unifiedSocialCreditCode String?       @unique @map("unified_social_credit_code")
  identityNoEncrypted     String?       @map("identity_no_encrypted")
  identityNoLast4         String?       @map("identity_no_last4")
  primaryContactName      String?       @map("primary_contact_name")
  primaryContactPhone     String?       @map("primary_contact_phone")
  supplyCategory          String?       @map("supply_category")
  commonMaterials         String?       @map("common_materials")
  address                 String?
  settlementNotes         String?       @map("settlement_notes")
  status                  BaseStatus    @default(enabled)
  remark                  String?
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  defaultedMaterials        Material[]    @relation("DefaultSupplierMaterials")
  clientProjectSites        ProjectSite[] @relation("ProjectSiteClientParty")
  operatorProjectSites      ProjectSite[] @relation("ProjectSiteOperatorParty")
  subcontractorProjectSites ProjectSite[] @relation("ProjectSiteSubcontractorParty")
  purchaseRecords           PurchaseRecord[]
  contracts                 Contract[]
  certificates              CertificateRecord[]
  marketOperationsHandoffs  MarketOperationsHandoff[]
  externalProjectSiteAccounts ExternalProjectSiteAccount[]

  @@index([status])
  @@index([partyName])
  @@index([entityType])
  @@map("parties")
}

model Material {
  id                 String                  @id @default(uuid()) @db.Uuid
  materialCode       String                  @unique @map("material_code")
  materialName       String                  @map("material_name")
  specification      String?
  materialCategory   String                  @map("material_category")
  baseUnit           String                  @map("base_unit")
  defaultWarehouseId String?                 @map("default_warehouse_id") @db.Uuid
  defaultSupplierPartyId String?             @map("default_supplier_party_id") @db.Uuid
  safeStock          Decimal?                @map("safe_stock") @db.Decimal(14, 3)
  isProjectSiteSaleEnabled Boolean           @default(false) @map("is_project_site_sale_enabled")
  purchaseReferencePrice Decimal?            @map("purchase_reference_price") @db.Decimal(14, 4)
  projectSiteSalePrice Decimal?              @map("project_site_sale_price") @db.Decimal(14, 4)
  projectSiteSaleUnit String?                @map("project_site_sale_unit")
  projectSiteSaleRemark String?              @map("project_site_sale_remark")
  isConsumable       Boolean                 @default(false) @map("is_consumable")
  status             BaseStatus              @default(enabled)
  remark             String?
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  defaultWarehouse   Warehouse?              @relation("DefaultWarehouseMaterials", fields: [defaultWarehouseId], references: [id])
  defaultSupplierParty Party?                 @relation("DefaultSupplierMaterials", fields: [defaultSupplierPartyId], references: [id], onDelete: SetNull)
  movements          InventoryMovement[]
  usageRequests      ProjectUsageRequest[]
  replenishmentSuggestions ReplenishmentSuggestion[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseRecordLines  PurchaseRecordLine[]

  @@index([defaultSupplierPartyId])
  @@map("materials")
}

model Warehouse {
  id                 String              @id @default(uuid()) @db.Uuid
  warehouseCode      String              @unique @map("warehouse_code")
  warehouseName      String              @map("warehouse_name")
  warehouseType      WarehouseType       @default(headquarters) @map("warehouse_type")
  projectSiteId      String?             @map("project_site_id") @db.Uuid
  managerName        String?             @map("manager_name")
  managerPhone       String?             @map("manager_phone")
  status             BaseStatus          @default(enabled)
  remark             String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  projectSite        ProjectSite?        @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  defaultedMaterials Material[]          @relation("DefaultWarehouseMaterials")
  movements          InventoryMovement[]
  usageRequests      ProjectUsageRequest[]
  replenishmentSuggestions ReplenishmentSuggestion[]

  @@index([projectSiteId])
  @@map("warehouses")
}

model InventoryMovement {
  id                    String                 @id @default(uuid()) @db.Uuid
  movementNo            String                 @unique @map("movement_no")
  movementDate          DateTime               @map("movement_date") @db.Date
  movementType          InventoryMovementType  @map("movement_type")
  sourceType            InventorySourceType?   @map("source_type")
  issueTargetType       IssueTargetType?       @map("issue_target_type")
  warehouseId           String                 @map("warehouse_id") @db.Uuid
  materialId            String                 @map("material_id") @db.Uuid
  quantity              Decimal                @db.Decimal(14, 3)
  unit                  String
  unitPrice             Decimal?               @map("unit_price") @db.Decimal(14, 4)
  unitChargePrice       Decimal?               @map("unit_charge_price") @db.Decimal(14, 4)
  chargeAmount          Decimal?               @map("charge_amount") @db.Decimal(14, 4)
  chargePriceSource     ChargePriceSource?     @map("charge_price_source")
  chargeRemark          String?                @map("charge_remark")
  purchaseRecordNo      String?                @map("purchase_record_no")
  purchaseRecordLineId  String?                @map("purchase_record_line_id") @db.Uuid
  projectSiteId         String?                @map("project_site_id") @db.Uuid
  subcontractorName     String?                @map("subcontractor_name")
  departmentName        String?                @map("department_name")
  requestedBy           String?                @map("requested_by")
  handledBy             String?                @map("handled_by")
  receivedByName        String?                @map("received_by_name")
  purpose               String?
  remark                String?
  usageRequestId        String?                @map("usage_request_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  material              Material               @relation(fields: [materialId], references: [id])
  purchaseRecordLine    PurchaseRecordLine?    @relation(fields: [purchaseRecordLineId], references: [id], onDelete: SetNull)
  projectSite           ProjectSite?           @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  usageRequest          ProjectUsageRequest?   @relation(fields: [usageRequestId], references: [id])

  @@index([warehouseId, materialId, movementDate])
  @@index([movementType, movementDate])
  @@index([purchaseRecordLineId])
  @@index([projectSiteId])
  @@map("inventory_movements")
}

model ProjectUsageRequest {
  id                String               @id @default(uuid()) @db.Uuid
  requestNo         String               @unique @map("request_no")
  requestDate       DateTime             @map("request_date") @db.Date
  projectSiteId     String               @map("project_site_id") @db.Uuid
  warehouseId       String               @map("warehouse_id") @db.Uuid
  materialId        String               @map("material_id") @db.Uuid
  requestedQuantity Decimal              @map("requested_quantity") @db.Decimal(14, 3)
  approvedQuantity  Decimal?             @map("approved_quantity") @db.Decimal(14, 3)
  issuedQuantity    Decimal              @default(0) @map("issued_quantity") @db.Decimal(14, 3)
  unit              String
  purpose           String?
  requestedBy       String?              @map("requested_by")
  submittedByAccountId String?           @map("submitted_by_account_id") @db.Uuid
  submittedByNameSnapshot String?        @map("submitted_by_name_snapshot")
  submittedByPhoneSnapshot String?       @map("submitted_by_phone_snapshot")
  expectedDate      DateTime?            @map("expected_date") @db.Date
  status            ProjectUsageStatus   @default(pending)
  outboundNo        String?              @map("outbound_no")
  unitChargePrice   Decimal?             @map("unit_charge_price") @db.Decimal(14, 4)
  chargeAmount      Decimal              @default(0) @map("charge_amount") @db.Decimal(14, 4)
  chargePriceSource ChargePriceSource?   @map("charge_price_source")
  chargeRemark      String?              @map("charge_remark")
  lastIssuedAt      DateTime?            @map("last_issued_at") @db.Date
  lastReceivedByName String?             @map("last_received_by_name")
  remark            String?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  projectSite       ProjectSite          @relation(fields: [projectSiteId], references: [id], onDelete: Restrict)
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id])
  material          Material             @relation(fields: [materialId], references: [id])
  submittedByExternalSiteAccount ExternalProjectSiteAccount? @relation(fields: [submittedByAccountId], references: [userAccountId], onDelete: SetNull)
  movements         InventoryMovement[]

  @@index([projectSiteId, requestDate])
  @@index([submittedByAccountId])
  @@index([status])
  @@map("project_usage_requests")
}

model MarketOperationsHandoff {
  id                        String                         @id @default(uuid()) @db.Uuid
  handoffNo                 String                         @unique @map("handoff_no")
  projectName               String                         @map("project_name")
  clientPartyId             String?                        @map("client_party_id") @db.Uuid
  clientName                String                         @map("client_name")
  projectSiteId             String?                        @map("project_site_id") @db.Uuid
  marketOwnerEmployeeId     String                         @map("market_owner_employee_id") @db.Uuid
  operationsOwnerEmployeeId String                         @map("operations_owner_employee_id") @db.Uuid
  status                    MarketOperationsHandoffStatus  @default(pending)
  expectedStartDate         DateTime?                      @map("expected_start_date") @db.Date
  handoffDate               DateTime?                      @map("handoff_date") @db.Date
  projectSummary            String?                        @map("project_summary")
  remark                    String?
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")

  clientParty     Party?      @relation(fields: [clientPartyId], references: [id], onDelete: SetNull)
  projectSite     ProjectSite? @relation(fields: [projectSiteId], references: [id], onDelete: SetNull)
  marketOwner     Employee    @relation("MarketOperationsHandoffMarketOwner", fields: [marketOwnerEmployeeId], references: [id], onDelete: Restrict)
  operationsOwner Employee    @relation("MarketOperationsHandoffOperationsOwner", fields: [operationsOwnerEmployeeId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([clientPartyId])
  @@index([projectSiteId])
  @@index([marketOwnerEmployeeId])
  @@index([operationsOwnerEmployeeId])
  @@map("market_operations_handoffs")
}

model ReplenishmentSuggestion {
  id                         String                         @id @default(uuid()) @db.Uuid
  warehouseId                String                         @map("warehouse_id") @db.Uuid
  materialId                 String                         @map("material_id") @db.Uuid
  safeStock                  Decimal                        @map("safe_stock") @db.Decimal(14, 3)
  currentStock               Decimal                        @map("current_stock") @db.Decimal(14, 3)
  reservedUsageQty           Decimal                        @map("reserved_usage_qty") @db.Decimal(14, 3)
  openPurchaseQty            Decimal                        @map("open_purchase_qty") @db.Decimal(14, 3)
  suggestedQuantity          Decimal                        @map("suggested_quantity") @db.Decimal(14, 3)
  status                     ReplenishmentSuggestionStatus  @default(open)
  convertedPurchaseRequestId String?                        @map("converted_purchase_request_id") @db.Uuid
  remark                     String?
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")

  warehouse                Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  material                 Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  convertedPurchaseRequest PurchaseRequest? @relation("ReplenishmentConvertedRequest", fields: [convertedPurchaseRequestId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([materialId])
  @@index([status])
  @@index([convertedPurchaseRequestId])
  @@map("replenishment_suggestions")
}

enum BaseStatus {
  enabled
  disabled
}

enum EmployeeStatus {
  active
  resigned
  disabled
}

enum UserAccountStatus {
  active
  disabled
  locked
}

enum RoleCode {
  admin
  hr
  procurement
  warehouse
  project_site
  marketing
  operations
  external_project_site
  viewer
}

enum MarketOperationsHandoffStatus {
  pending
  handed_over
  accepted
  cancelled
}

enum ProjectSiteStatus {
  preparing
  active
  paused
  ended
}

enum ProjectSiteRosterWorkerType {
  direct_site_staff
  subcontractor_site_staff
}

enum ProjectSiteRosterStatus {
  active
  left
}

enum ProjectSiteComplianceReviewStatus {
  pending
  approved
  rejected
}

enum ProjectSiteKitchenEquipmentStatus {
  in_use
  damaged
  repair_needed
  returned
  retired
}

enum ProjectSiteKitchenEquipmentChangeType {
  add
  quantity_change
  location_change
  status_change
  photo_or_note
}

enum EmployeeProjectSiteRelationType {
  assigned
  manager
  support
}

model Department {
  id                String       @id @default(uuid()) @db.Uuid
  departmentCode    String       @unique @map("department_code")
  name              String
  parentId          String?      @map("parent_id") @db.Uuid
  managerEmployeeId String?      @map("manager_employee_id") @db.Uuid
  status            BaseStatus   @default(enabled)
  sortOrder         Int          @default(0) @map("sort_order")
  remark            String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  parent          Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Department[] @relation("DepartmentHierarchy")
  managerEmployee Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees       Employee[]   @relation("EmployeeDepartment")
  purchaseRequests PurchaseRequest[]

  @@index([parentId])
  @@index([status])
  @@map("departments")
}

model Employee {
  id               String         @id @default(uuid()) @db.Uuid
  employeeNo       String         @unique @map("employee_no")
  name             String
  gender           String?
  phone            String?        @unique
  email            String?        @unique
  departmentId     String         @map("department_id") @db.Uuid
  position         String?
  employmentStatus EmployeeStatus @default(active) @map("employment_status")
  hireDate         DateTime?      @map("hire_date") @db.Date
  leaveDate        DateTime?      @map("leave_date") @db.Date
  remark           String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  department             Department                      @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  userAccount            UserAccount?
  managedDepartments     Department[]                    @relation("DepartmentManager")
  managedProjectSites    ProjectSite[]                   @relation("ProjectSitePrimaryManager")
  projectSiteAssignments EmployeeProjectSiteAssignment[]
  requestedPurchases     PurchaseRequest[]               @relation("PurchaseRequestRequester")
  reviewedPurchaseRequests PurchaseRequest[]              @relation("PurchaseRequestReviewer")
  handledPurchases       PurchaseRecord[]                @relation("PurchaseRecordPurchaser")
  ownedCertificates      CertificateRecord[]             @relation("CertificateOwnerEmployee")
  responsibleCertificates CertificateRecord[]             @relation("CertificateResponsibleEmployee")
  confirmedCertificates  CertificateRecord[]             @relation("CertificateConfirmedByEmployee")
  reviewedInsurancePolicies ProjectSiteEmployerLiabilityInsurancePolicy[] @relation("InsuranceReviewedByEmployee")
  reviewedPayrollSubmissions ProjectSitePayrollSubmission[] @relation("PayrollReviewedByEmployee")
  reviewedKitchenEquipmentChangeRequests ProjectSiteKitchenEquipmentChangeRequest[] @relation("KitchenEquipmentChangeReviewedByEmployee")
  marketOwnedHandoffs    MarketOperationsHandoff[]       @relation("MarketOperationsHandoffMarketOwner")
  operationsOwnedHandoffs MarketOperationsHandoff[]       @relation("MarketOperationsHandoffOperationsOwner")
  managedBusinessProjects BusinessProject[]               @relation("BusinessProjectManager")

  @@index([departmentId])
  @@index([employmentStatus])
  @@map("employees")
}

model BusinessProject {
  id                String                @id @default(uuid()) @db.Uuid
  projectCode       String                @unique @map("project_code")
  projectName       String                @map("project_name")
  projectType       BusinessProjectType   @default(self_operated_construction) @map("project_type")
  status            BusinessProjectStatus @default(preparing)
  location          String?
  managerEmployeeId String?               @map("manager_employee_id") @db.Uuid
  startDate         DateTime?             @map("start_date") @db.Date
  endDate           DateTime?             @map("end_date") @db.Date
  remark            String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  managerEmployee Employee?     @relation("BusinessProjectManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  projectSites    ProjectSite[]
  contracts       Contract[]

  @@index([projectType])
  @@index([status])
  @@index([managerEmployeeId])
  @@map("business_projects")
}

model UserAccount {
  id                String            @id @default(uuid()) @db.Uuid
  employeeId        String?           @unique @map("employee_id") @db.Uuid
  username          String            @unique
  passwordHash      String            @map("password_hash")
  status            UserAccountStatus @default(active)
  lastLoginAt       DateTime?         @map("last_login_at")
  passwordChangedAt DateTime?         @map("password_changed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  employee            Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles               UserRoleAssignment[]  @relation("UserAccountRoles")
  assignedRoleChanges UserRoleAssignment[]  @relation("AssignedUserRoles")
  externalProjectSiteAccount ExternalProjectSiteAccount?

  @@index([status])
  @@map("user_accounts")
}

model UserRoleAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  userAccountId    String    @map("user_account_id") @db.Uuid
  role             RoleCode
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at")

  userAccount UserAccount  @relation("UserAccountRoles", fields: [userAccountId], references: [id], onDelete: Cascade)
  assignedBy  UserAccount? @relation("AssignedUserRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userAccountId, role])
  @@index([role])
  @@index([assignedByUserId])
  @@map("user_role_assignments")
}

model ProjectSite {
  id                       String            @id @default(uuid()) @db.Uuid
  siteCode                 String            @unique @map("site_code")
  siteName                 String            @map("site_name")
  businessProjectId        String?           @map("business_project_id") @db.Uuid
  clientPartyId            String?           @map("client_party_id") @db.Uuid
  operatorPartyId          String?           @map("operator_party_id") @db.Uuid
  serviceMode              ProjectSiteServiceMode @default(direct) @map("service_mode")
  subcontractorPartyId     String?           @map("subcontractor_party_id") @db.Uuid
  region                   String?
  siteAddress              String?           @map("site_address")
  serviceType              String?           @map("service_type")
  status                   ProjectSiteStatus @default(active)
  payrollAgencyRequired    Boolean           @default(false) @map("payroll_agency_required")
  startDate                DateTime?         @map("start_date") @db.Date
  endDate                  DateTime?         @map("end_date") @db.Date
  primaryManagerEmployeeId String?           @map("primary_manager_employee_id") @db.Uuid
  clientContactName        String?           @map("client_contact_name")
  clientContactPhone       String?           @map("client_contact_phone")
  subcontractorContactName String?           @map("subcontractor_contact_name")
  subcontractorContactPhone String?          @map("subcontractor_contact_phone")
  remark                   String?
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  businessProject BusinessProject?                @relation(fields: [businessProjectId], references: [id], onDelete: SetNull)
  primaryManager Employee?                       @relation("ProjectSitePrimaryManager", fields: [primaryManagerEmployeeId], references: [id], onDelete: SetNull)
  clientParty    Party?                          @relation("ProjectSiteClientParty", fields: [clientPartyId], references: [id], onDelete: Restrict)
  operatorParty  Party?                          @relation("ProjectSiteOperatorParty", fields: [operatorPartyId], references: [id], onDelete: Restrict)
  subcontractorParty Party?                       @relation("ProjectSiteSubcontractorParty", fields: [subcontractorPartyId], references: [id], onDelete: Restrict)
  assignments    EmployeeProjectSiteAssignment[]
  warehouses      Warehouse[]
  inventoryMoves  InventoryMovement[]
  usageRequests   ProjectUsageRequest[]
  marketOperationsHandoffs MarketOperationsHandoff[]
  purchaseRequests PurchaseRequest[]
  contracts        Contract[]
  certificates     CertificateRecord[]
  externalProjectSiteAccounts ExternalProjectSiteAccount[]
  rosterPeople     ProjectSiteRosterPerson[]
  employerLiabilityInsurancePolicies ProjectSiteEmployerLiabilityInsurancePolicy[]
  payrollSubmissions ProjectSitePayrollSubmission[]
  kitchenEquipment ProjectSiteKitchenEquipment[]
  kitchenEquipmentChangeRequests ProjectSiteKitchenEquipmentChangeRequest[]

  @@index([status])
  @@index([businessProjectId])
  @@index([primaryManagerEmployeeId])
  @@index([clientPartyId])
  @@index([operatorPartyId])
  @@index([subcontractorPartyId])
  @@map("project_sites")
}

model ProjectSiteRosterPerson {
  id                   String                      @id @default(uuid()) @db.Uuid
  projectSiteId        String                      @map("project_site_id") @db.Uuid
  personName           String                      @map("person_name")
  phone                String?
  identityNoLast4      String?                     @map("identity_no_last4")
  workerType           ProjectSiteRosterWorkerType @map("worker_type")
  jobRole              String?                     @map("job_role")
  startDate            DateTime?                   @map("start_date") @db.Date
  endDate              DateTime?                   @map("end_date") @db.Date
  status               ProjectSiteRosterStatus     @default(active)
  sourceAttachmentPath String?                     @map("source_attachment_path")
  remark               String?
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  projectSite        ProjectSite @relation(fields: [projectSiteId], references: [id], onDelete: Cascade)
  healthCertificates CertificateRecord[]
  insuranceCoverages ProjectSiteEmployerLiabilityInsuranceCoveredPerson[]

  @@index([projectSiteId])
  @@index([status])
  @@index([workerType])
  @@map("project_site_roster_people")
}

model ProjectSiteEmployerLiabilityInsurancePolicy {
