POSTGRES_USER=company_erp
POSTGRES_PASSWORD=change-me-in-nas
POSTGRES_DB=company_erp
POSTGRES_PORT=5432

# Local development API database URL. Docker Compose uses the postgres service
# name internally and builds its own container DATABASE_URL from POSTGRES_*.
DATABASE_URL=postgresql://company_erp:change-me-in-nas@localhost:5432/company_erp?schema=public
API_PORT=3001
API_HOST=0.0.0.0

# Local Vite dev server API URL. The Docker web image intentionally builds this
# as an empty string so browser requests use same-origin /api and /health.
VITE_API_BASE_URL=http://localhost:3001

# Auth/session. Replace this placeholder with a long random value in real local/NAS .env.
# The API refuses to start with this placeholder when DATABASE_URL enables auth.
AUTH_SESSION_SECRET=change-me-long-random-local-secret
AUTH_COOKIE_SECURE=false

# One-time bootstrap for the first admin account. Do not commit real passwords.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-use

# Pilot workflow smoke test. Use a real admin account in local/NAS .env only.
ERP_API_BASE_URL=http://localhost:3001
PILOT_ADMIN_USERNAME=admin
PILOT_ADMIN_PASSWORD=change-me-before-use

# Operational recovery. Use real values only in local/NAS .env.
RESET_ACCOUNT_USERNAME=admin
RESET_ACCOUNT_PASSWORD=change-me-before-use
DEMO_CLEANUP_DRY_RUN=true
CONFIRM_DEMO_CLEANUP=

# NAS deployment persistence roots. Keep these on durable NAS storage.
NAS_DATA_ROOT=./data
NAS_ATTACHMENTS_ROOT=./attachments
ERP_WEB_PORT=8080

# Non-secret deployment metadata. Deployment sync can set these values so the
# Web UI, /health, /api/app-version, and .deploy-revision.json show the same revision.
APP_COMMIT_SHA=unknown
APP_BUILD_TIME=unknown
APP_DEPLOYED_AT=unknown
APP_PACKAGE_VERSION=0.1.0
APP_ENVIRONMENT=local
