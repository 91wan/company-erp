POSTGRES_USER=company_erp
POSTGRES_PASSWORD=change-me-in-nas
POSTGRES_DB=company_erp

DATABASE_URL=postgresql://company_erp:change-me-in-nas@localhost:5432/company_erp?schema=public
API_PORT=3001
API_HOST=0.0.0.0
VITE_API_BASE_URL=http://localhost:3001

# Auth/session. Replace this placeholder with a long random value in real local/NAS .env.
# The API refuses to start with this placeholder when DATABASE_URL enables auth.
AUTH_SESSION_SECRET=change-me-long-random-local-secret
AUTH_COOKIE_SECURE=false

# One-time bootstrap for the first admin account. Do not commit real passwords.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-use

# NAS deployment persistence roots. Keep these on durable NAS storage.
NAS_DATA_ROOT=./data
NAS_ATTACHMENTS_ROOT=./attachments
