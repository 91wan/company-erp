{
  "name": "@company-erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "bootstrap:admin": "tsx src/bootstrap/bootstrapAdmin.ts",
    "bootstrap:admin:prod": "node dist/bootstrap/bootstrapAdmin.js",
    "bootstrap:trial-data": "tsx src/bootstrap/bootstrapTrialData.ts",
    "bootstrap:trial-data:prod": "node dist/bootstrap/bootstrapTrialData.js",
    "smoke:pilot": "tsx src/bootstrap/pilotSmoke.ts",
    "smoke:pilot:prod": "node dist/bootstrap/pilotSmoke.js",
    "account:reset-password": "tsx src/bootstrap/resetAccountPassword.ts",
    "account:reset-password:prod": "node dist/bootstrap/resetAccountPassword.js",
    "demo:cleanup": "tsx src/bootstrap/demoCleanupCli.ts",
    "demo:cleanup:prod": "node dist/bootstrap/demoCleanupCli.js",
    "build": "tsc -p tsconfig.build.json && node -e \"import('./dist/app.js').then(() => console.log('api dist import ok'))\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@company-erp/shared": "file:../../packages/shared",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.5.0",
    "exceljs": "4.4.0",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsx": "^4.19.4",
    "vitest": "^3.1.3"
  }
}
