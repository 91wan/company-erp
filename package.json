{
  "name": "company-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @company-erp/api\" \"npm run dev -w @company-erp/web\"",
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema database/prisma/schema.prisma",
    "preflight:nas": "bash scripts/preflight-nas.sh",
    "test:backup-restore": "bash scripts/test-backup-restore.sh",
    "pilot:verify-local": "bash scripts/pilot-verify-local.sh",
    "pilot:verify-evidence": "node scripts/verify-pilot-evidence-manifest.mjs",
    "audit:verify-export": "node scripts/verify-audit-export.mjs",
    "attachments:legacy-report": "node scripts/attachments-legacy-report.mjs",
    "nas:trial-readiness": "node scripts/nas-trial-readiness-gate.mjs",
    "import:pilot-check": "node scripts/import-pilot-check.mjs",
    "import:pilot-smoke": "node scripts/import-pilot-smoke.mjs",
    "pilot:ready": "bash scripts/pilot-ready.sh",
    "production:readiness-gate": "node scripts/production-readiness-gate.mjs",
    "production:ready": "bash scripts/production-ready.sh",
    "production:restore-drill-check": "node scripts/production-restore-drill-check.mjs",
    "attachments:production-check": "node scripts/attachment-production-check.mjs",
    "access:review-check": "node scripts/access-review-check.mjs",
    "production:health-check": "node scripts/production-health-check.mjs",
    "production:go-live-check": "node scripts/production-go-live-check.mjs",
    "production:go-live-ready": "bash scripts/production-go-live-ready.sh",
    "production:evidence-template": "node scripts/create-go-live-evidence-template.mjs",
    "production:evidence-collect": "node scripts/production-evidence-collect.mjs",
    "production:cutover-check": "node scripts/production-cutover-check.mjs",
    "production:post-go-live-24h-check": "node scripts/post-go-live-24h-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  }
}
