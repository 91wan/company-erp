{
  "name": "company-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @company-erp/api\" \"npm run dev -w @company-erp/web\"",
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema database/prisma/schema.prisma",
    "test:backup-restore": "bash scripts/test-backup-restore.sh",
    "public:readiness-gate": "node scripts/public-internet-readiness-gate.mjs",
    "public:go-live-check": "node scripts/public-go-live-check.mjs",
    "public:security-evidence-check": "node scripts/public-security-evidence-check.mjs",
    "auth:revoke-all-sessions": "node scripts/revoke-all-sessions.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  }
}
