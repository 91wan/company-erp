{
  "name": "company-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @company-erp/api\" \"npm run dev -w @company-erp/web\"",
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema database/prisma/schema.prisma",
    "preflight:nas": "bash scripts/preflight-nas.sh",
    "test:backup-restore": "bash scripts/test-backup-restore.sh",
    "pilot:verify-local": "bash scripts/pilot-verify-local.sh",
    "pilot:verify-evidence": "node scripts/verify-pilot-evidence-manifest.mjs",
    "audit:verify-export": "node scripts/verify-audit-export.mjs",
    "attachments:legacy-report": "node scripts/attachments-legacy-report.mjs",
    "nas:trial-readiness": "node scripts/nas-trial-readiness-gate.mjs",
    "import:pilot-check": "node scripts/import-pilot-check.mjs",
    "import:pilot-smoke": "node scripts/import-pilot-smoke.mjs",
    "pilot:ready": "npm run db:generate && npm run db:validate && npm run typecheck && npm run test && npm run build && npm run test:e2e -w @company-erp/web && npm run import:pilot-check && npm run import:pilot-smoke && npm run nas:trial-readiness"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  }
}
